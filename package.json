{
  "name": "morfeed",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:extension": "npm --prefix extension run dev",
    "build": "next build",
    "build:extension": "npm --prefix extension run build",
    "start": "next start",
    "lint": "eslint",
    "lint:extension": "eslint extension --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test:extension": "npm --prefix extension run test",
    "typecheck": "tsc --noEmit",
    "typecheck:extension": "npm --prefix extension run typecheck"
  },
  "dependencies": {
